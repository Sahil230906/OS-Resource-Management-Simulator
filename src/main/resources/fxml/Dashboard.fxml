<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ossim.controllers.DashboardController"
            stylesheets="@../css/style.css">

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10">
            <StackPane>
                <Rectangle width="34" height="34" arcWidth="10" arcHeight="10" fill="#89b4fa" />
                <Label text="OS" style="-fx-text-fill: #1e1e2e; -fx-font-size: 13px; -fx-font-weight: bold;" />
            </StackPane>
            <Label text="OS Resource Management &amp; Algorithm Simulator"
                   style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label text="● System Ready" styleClass="status-ready" />
        </HBox>
    </top>

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar" spacing="6" prefWidth="200">
            <padding>
                <Insets top="16" right="10" bottom="16" left="10" />
            </padding>

            <Label text="NAVIGATE" style="-fx-text-fill: #6c7086; -fx-font-size: 10px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets left="8" bottom="4" />
                </VBox.margin>
            </Label>

            <Button fx:id="cpuButton" text="CPU Scheduling" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="memoryButton" text="Memory Management" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="pageButton" text="Page Replacement" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="diskButton" text="Disk Scheduling" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="deadlockButton" text="Deadlock Detection" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="comparisonButton" text="Comparison" styleClass="sidebar-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
            <VBox spacing="26">
                <padding>
                    <Insets top="24" right="28" bottom="28" left="28" />
                </padding>

                <!-- ===== HERO SECTION ===== -->
                <VBox styleClass="dashboard-card" spacing="10" style="-fx-padding: 26;">
                    <Label text="Welcome back" style="-fx-text-fill: #89b4fa; -fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label text="Explore Operating System Algorithms" styleClass="workspace-title" style="-fx-font-size: 24px;" />
                    <Label text="Simulate, visualize, and compare CPU scheduling, memory allocation, page replacement, disk scheduling, and deadlock detection — all with real, step-by-step generated output."
                           styleClass="workspace-subtitle" wrapText="true" maxWidth="700" />
                    <HBox spacing="12">
                        <VBox.margin>
                            <Insets top="6" />
                        </VBox.margin>
                        <Button fx:id="runEverythingButton" text="▶ Run Everything (Demo Mode)"
                                style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 12 24 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;" />
                    </HBox>
                </VBox>

                <!-- ===== MODULES ===== -->
                <VBox spacing="10">
                    <Label text="Modules" style="-fx-text-fill: #cdd6f4; -fx-font-size: 16px; -fx-font-weight: bold;" />

                    <FlowPane fx:id="cardContainer" hgap="16" vgap="16">

                        <!-- CPU: chip icon -->
                        <VBox fx:id="cpuCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                            <StackPane>
                                <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#89b4fa" />
                                <Rectangle width="12" height="12" arcWidth="2" arcHeight="2" fill="#1e1e2e" />
                            </StackPane>
                            <Label text="CPU Scheduling" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Label text="Watch processes race across a live Gantt chart under FCFS, SJF, Priority, and Round Robin."
                                   styleClass="card-subtitle" wrapText="true" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Memory: stacked bars icon -->
                        <VBox fx:id="memoryCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                            <StackPane>
                                <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#f9e2af" />
                                <VBox spacing="3" alignment="CENTER">
                                    <Rectangle width="16" height="3" fill="#1e1e2e" />
                                    <Rectangle width="16" height="3" fill="#1e1e2e" />
                                    <Rectangle width="16" height="3" fill="#1e1e2e" />
                                </VBox>
                            </StackPane>
                            <Label text="Memory Management" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Label text="See how First, Best, and Worst Fit carve up memory blocks as a stacked map."
                                   styleClass="card-subtitle" wrapText="true" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Page Replacement: page with text lines icon -->
                        <VBox fx:id="pageCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                            <StackPane>
                                <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#94e2d5" />
                                <VBox spacing="3" alignment="CENTER">
                                    <Rectangle width="14" height="2.5" fill="#1e1e2e" />
                                    <Rectangle width="14" height="2.5" fill="#1e1e2e" />
                                    <Rectangle width="9" height="2.5" fill="#1e1e2e" />
                                </VBox>
                            </StackPane>
                            <Label text="Page Replacement" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Label text="Track page faults frame-by-frame across FIFO, LRU, and Optimal replacement."
                                   styleClass="card-subtitle" wrapText="true" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Disk: platter icon -->
                        <VBox fx:id="diskCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                            <StackPane>
                                <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#fab387" />
                                <Circle radius="9" fill="TRANSPARENT" stroke="#1e1e2e" strokeWidth="2.5" />
                                <Circle radius="2.5" fill="#1e1e2e" />
                            </StackPane>
                            <Label text="Disk Scheduling" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Label text="Trace the disk head's path across FCFS, SSTF, SCAN, and C-SCAN seek graphs."
                                   styleClass="card-subtitle" wrapText="true" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Deadlock: padlock icon -->
                        <VBox fx:id="deadlockCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16" />
                            </padding>
                            <StackPane>
                                <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#f38ba8" />
                                <VBox alignment="CENTER" spacing="0">
                                    <Arc radiusX="4.5" radiusY="4.5" startAngle="0" length="180" type="OPEN" stroke="#1e1e2e" strokeWidth="2" fill="TRANSPARENT" />
                                    <Rectangle width="13" height="9" arcWidth="2" arcHeight="2" fill="#1e1e2e" />
                                </VBox>
                            </StackPane>
                            <Label text="Deadlock Detection" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Label text="Run the Banker's Algorithm and watch the safe sequence get traced step by step."
                                   styleClass="card-subtitle" wrapText="true" />
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        </VBox>

                        <!-- Comparison: bar chart icon -->
<VBox fx:id="comparisonCard" styleClass="module-card" prefWidth="260" prefHeight="150" spacing="8">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>
    <StackPane>
        <Rectangle width="30" height="30" arcWidth="8" arcHeight="8" fill="#cba6f7" />
        <Group>
            <Rectangle x="0" y="6" width="3" height="6" fill="#1e1e2e" />
            <Rectangle x="5" y="3" width="3" height="9" fill="#1e1e2e" />
            <Rectangle x="10" y="0" width="3" height="12" fill="#1e1e2e" />
        </Group>
    </StackPane>
    <Label text="Algorithm Comparison" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
    <Label text="Run every algorithm across all 4 domains side by side and see which one wins on your input."
           styleClass="card-subtitle" wrapText="true" />
    <Region VBox.vgrow="ALWAYS" />
    <Label text="OPEN →" style="-fx-text-fill: #89b4fa; -fx-font-size: 11px; -fx-font-weight: bold;" />
</VBox>

                    </FlowPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
