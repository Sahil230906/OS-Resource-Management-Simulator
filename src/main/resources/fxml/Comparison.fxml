<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ossim.controllers.ComparisonController"
            stylesheets="@../css/style.css">

    <!-- ===== TOP STATUS BAR ===== -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="10">
            <Button text="← Back to Dashboard" fx:id="backButton" styleClass="sidebar-button" />
            <Label text="📊 COMPARISON" style="-fx-text-fill: #cdd6f4; -fx-font-size: 15px; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label text="● System Ready" styleClass="status-ready" />
        </HBox>
    </top>

    <!-- ===== MAIN WORKSPACE ===== -->
    <center>
        <TabPane style="-fx-background-color: #1e1e2e;" tabClosingPolicy="UNAVAILABLE">

            <!-- ===================================================== -->
            <!-- TAB 1: CPU SCHEDULING (unchanged from before)          -->
            <!-- ===================================================== -->
            <Tab text="CPU Scheduling">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
                    <VBox styleClass="main-workspace" spacing="20">

                        <Label text="Algorithm Comparison" styleClass="workspace-title" />
                        <Label text="Run multiple CPU scheduling algorithms on the same input and compare performance"
                               styleClass="workspace-subtitle" />

                        <VBox spacing="10">
                            <Label text="Process Input" styleClass="card-title" />
                            <TableView fx:id="processTable" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colProcessId" text="Process ID" prefWidth="120" />
                                    <TableColumn fx:id="colArrivalTime" text="Arrival Time" prefWidth="120" />
                                    <TableColumn fx:id="colBurstTime" text="Burst Time" prefWidth="120" />
                                    <TableColumn fx:id="colPriority" text="Priority" prefWidth="120" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button text="+ Add Process" fx:id="addProcessButton" styleClass="dashboard-card" />
                                <Button text="− Remove Selected" fx:id="removeProcessButton" styleClass="dashboard-card" />
                                <Button text="Clear All" fx:id="clearButton" styleClass="dashboard-card" />
                                <Button text="Load Example" fx:id="loadExampleButton" styleClass="dashboard-card" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Select Algorithms to Compare" styleClass="card-title" />
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <CheckBox fx:id="fcfsCheck" text="FCFS" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="sjfCheck" text="SJF" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="priorityCheck" text="Priority" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="rrCheck" text="Round Robin" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <Label text="Quantum:" style="-fx-text-fill: #a6adc8;" />
                                <TextField fx:id="quantumField" prefWidth="50" text="2" />
                            </HBox>
                            <Button text="▶ COMPARE" fx:id="compareButton"
                                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </VBox>

                        <VBox spacing="10" fx:id="resultsSection" visible="false" managed="false">
                            <Label text="Comparison Results" styleClass="card-title" />
                            <TableView fx:id="comparisonTable" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colAlgoName" text="Algorithm" prefWidth="180" />
                                    <TableColumn fx:id="colAvgWaiting" text="Avg Waiting Time" prefWidth="180" />
                                    <TableColumn fx:id="colAvgTurnaround" text="Avg Turnaround Time" prefWidth="180" />
                                    <TableColumn fx:id="colAvgResponse" text="Avg Response Time" prefWidth="180" />
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="8" fx:id="winnerSection" styleClass="dashboard-card" visible="false" managed="false">
                            <Label text="🏆 BEST PERFORMANCE" style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            <Label fx:id="winnerNameLabel" text="-" styleClass="workspace-title" />
                            <Label fx:id="winnerReasonLabel" text="-" styleClass="card-subtitle" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ===================================================== -->
            <!-- TAB 2: MEMORY MANAGEMENT                               -->
            <!-- ===================================================== -->
            <Tab text="Memory Management">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
                    <VBox styleClass="main-workspace" spacing="20">

                        <Label text="Memory Allocation Comparison" styleClass="workspace-title" />
                        <Label text="Run multiple allocation algorithms on the same partitions and processes"
                               styleClass="workspace-subtitle" />

                        <VBox spacing="10">
                            <Label text="Partition Input" styleClass="card-title" />
                            <TableView fx:id="memPartitionTable" prefHeight="150">
                                <columns>
                                    <TableColumn fx:id="memColBlockId" text="Block ID" prefWidth="150" />
                                    <TableColumn fx:id="memColBlockSize" text="Size (MB)" prefWidth="150" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button text="+ Add Partition" fx:id="memAddPartitionButton" styleClass="dashboard-card" />
                                <Button text="− Remove Selected" fx:id="memRemovePartitionButton" styleClass="dashboard-card" />
                                <Button text="Clear All" fx:id="memClearPartitionsButton" styleClass="dashboard-card" />
                                <Button text="Load Example" fx:id="memLoadPartitionExampleButton" styleClass="dashboard-card" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Process Input" styleClass="card-title" />
                            <TableView fx:id="memProcessTable" prefHeight="150">
                                <columns>
                                    <TableColumn fx:id="memColProcessId" text="Process ID" prefWidth="150" />
                                    <TableColumn fx:id="memColProcessSize" text="Size (MB)" prefWidth="150" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button text="+ Add Process" fx:id="memAddProcessButton" styleClass="dashboard-card" />
                                <Button text="− Remove Selected" fx:id="memRemoveProcessButton" styleClass="dashboard-card" />
                                <Button text="Clear All" fx:id="memClearProcessesButton" styleClass="dashboard-card" />
                                <Button text="Load Example" fx:id="memLoadProcessExampleButton" styleClass="dashboard-card" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Select Algorithms to Compare" styleClass="card-title" />
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <CheckBox fx:id="memFirstFitCheck" text="First Fit" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="memBestFitCheck" text="Best Fit" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="memWorstFitCheck" text="Worst Fit" selected="true" style="-fx-text-fill: #cdd6f4;" />
                            </HBox>
                            <Button text="▶ COMPARE" fx:id="memCompareButton"
                                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </VBox>

                        <VBox spacing="10" fx:id="memResultsSection" visible="false" managed="false">
                            <Label text="Comparison Results" styleClass="card-title" />
                            <TableView fx:id="memComparisonTable" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="memColAlgoName" text="Algorithm" prefWidth="150" />
                                    <TableColumn fx:id="memColAllocated" text="Allocated" prefWidth="100" />
                                    <TableColumn fx:id="memColFailed" text="Failed" prefWidth="100" />
                                    <TableColumn fx:id="memColFragmentation" text="Internal Fragmentation" prefWidth="180" />
                                    <TableColumn fx:id="memColFreeMemory" text="Total Free Memory" prefWidth="160" />
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="8" fx:id="memWinnerSection" styleClass="dashboard-card" visible="false" managed="false">
                            <Label text="🏆 BEST PERFORMANCE" style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            <Label fx:id="memWinnerNameLabel" text="-" styleClass="workspace-title" />
                            <Label fx:id="memWinnerReasonLabel" text="-" styleClass="card-subtitle" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ===================================================== -->
            <!-- TAB 3: PAGE REPLACEMENT                                -->
            <!-- ===================================================== -->
            <Tab text="Page Replacement">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
                    <VBox styleClass="main-workspace" spacing="20">

                        <Label text="Page Replacement Comparison" styleClass="workspace-title" />
                        <Label text="Run multiple page replacement algorithms on the same reference string"
                               styleClass="workspace-subtitle" />

                        <VBox spacing="10">
                            <Label text="Reference String" styleClass="card-title" />
                            <TableView fx:id="pageReferenceTable" prefHeight="150">
                                <columns>
                                    <TableColumn fx:id="pageColPageNumber" text="Page Number" prefWidth="200" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button text="+ Add Page" fx:id="pageAddRefButton" styleClass="dashboard-card" />
                                <Button text="− Remove Selected" fx:id="pageRemoveRefButton" styleClass="dashboard-card" />
                                <Button text="Clear All" fx:id="pageClearRefButton" styleClass="dashboard-card" />
                                <Button text="Load Example" fx:id="pageLoadRefExampleButton" styleClass="dashboard-card" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Select Algorithms to Compare" styleClass="card-title" />
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <Label text="Frame Count:" style="-fx-text-fill: #a6adc8;" />
                                <TextField fx:id="pageFrameCountField" prefWidth="50" text="3" />
                                <CheckBox fx:id="pageFifoCheck" text="FIFO" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="pageLruCheck" text="LRU" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="pageOptimalCheck" text="Optimal" selected="true" style="-fx-text-fill: #cdd6f4;" />
                            </HBox>
                            <Button text="▶ COMPARE" fx:id="pageCompareButton"
                                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </VBox>

                        <VBox spacing="10" fx:id="pageResultsSection" visible="false" managed="false">
                            <Label text="Comparison Results" styleClass="card-title" />
                            <TableView fx:id="pageComparisonTable" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="pageColAlgoName" text="Algorithm" prefWidth="150" />
                                    <TableColumn fx:id="pageColHits" text="Hits" prefWidth="100" />
                                    <TableColumn fx:id="pageColFaults" text="Faults" prefWidth="100" />
                                    <TableColumn fx:id="pageColHitRatio" text="Hit Ratio" prefWidth="120" />
                                    <TableColumn fx:id="pageColFaultRatio" text="Fault Ratio" prefWidth="120" />
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="8" fx:id="pageWinnerSection" styleClass="dashboard-card" visible="false" managed="false">
                            <Label text="🏆 BEST PERFORMANCE" style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            <Label fx:id="pageWinnerNameLabel" text="-" styleClass="workspace-title" />
                            <Label fx:id="pageWinnerReasonLabel" text="-" styleClass="card-subtitle" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- ===================================================== -->
            <!-- TAB 4: DISK SCHEDULING                                 -->
            <!-- ===================================================== -->
            <Tab text="Disk Scheduling">
                <ScrollPane fitToWidth="true" style="-fx-background-color: #1e1e2e; -fx-background: #1e1e2e;">
                    <VBox styleClass="main-workspace" spacing="20">

                        <Label text="Disk Scheduling Comparison" styleClass="workspace-title" />
                        <Label text="Run multiple disk scheduling algorithms on the same track requests"
                               styleClass="workspace-subtitle" />

                        <VBox spacing="10">
                            <Label text="Track Requests" styleClass="card-title" />
                            <TableView fx:id="diskRequestTable" prefHeight="150">
                                <columns>
                                    <TableColumn fx:id="diskColTrackNumber" text="Track Number" prefWidth="200" />
                                </columns>
                            </TableView>
                            <HBox spacing="10">
                                <Button text="+ Add Track" fx:id="diskAddRequestButton" styleClass="dashboard-card" />
                                <Button text="− Remove Selected" fx:id="diskRemoveRequestButton" styleClass="dashboard-card" />
                                <Button text="Clear All" fx:id="diskClearRequestButton" styleClass="dashboard-card" />
                                <Button text="Load Example" fx:id="diskLoadRequestExampleButton" styleClass="dashboard-card" />
                            </HBox>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Disk Settings &amp; Algorithm Selection" styleClass="card-title" />
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Initial Head:" style="-fx-text-fill: #a6adc8;" />
                                <TextField fx:id="diskHeadPositionField" prefWidth="60" text="50" />
                                <Label text="Disk Size:" style="-fx-text-fill: #a6adc8;" />
                                <TextField fx:id="diskSizeField" prefWidth="60" text="199" />
                                <Label text="Direction:" style="-fx-text-fill: #a6adc8;" />
                                <ComboBox fx:id="diskDirectionSelector" prefWidth="140" />
                            </HBox>
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <CheckBox fx:id="diskFcfsCheck" text="FCFS" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="diskSstfCheck" text="SSTF" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="diskScanCheck" text="SCAN" selected="true" style="-fx-text-fill: #cdd6f4;" />
                                <CheckBox fx:id="diskCscanCheck" text="C-SCAN" selected="true" style="-fx-text-fill: #cdd6f4;" />
                            </HBox>
                            <Button text="▶ COMPARE" fx:id="diskCompareButton"
                                    style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />
                        </VBox>

                        <VBox spacing="10" fx:id="diskResultsSection" visible="false" managed="false">
                            <Label text="Comparison Results" styleClass="card-title" />
                            <TableView fx:id="diskComparisonTable" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="diskColAlgoName" text="Algorithm" prefWidth="150" />
                                    <TableColumn fx:id="diskColTotalMovement" text="Total Head Movement" prefWidth="180" />
                                    <TableColumn fx:id="diskColAvgMovement" text="Avg Head Movement" prefWidth="180" />
                                </columns>
                            </TableView>
                        </VBox>

                        <VBox spacing="8" fx:id="diskWinnerSection" styleClass="dashboard-card" visible="false" managed="false">
                            <Label text="🏆 BEST PERFORMANCE" style="-fx-text-fill: #f9e2af; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            <Label fx:id="diskWinnerNameLabel" text="-" styleClass="workspace-title" />
                            <Label fx:id="diskWinnerReasonLabel" text="-" styleClass="card-subtitle" />
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>